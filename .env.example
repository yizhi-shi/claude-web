# Claude Code Web configuration
PORT=8010
HOST=0.0.0.0
DATA_DIR=./data

# Directories the project picker and session cwd validation accept.
# Use your own project root; the default is the current user's home.
ALLOWED_ROOTS=/home/you

# New sessions default to this directory unless the user picks another one.
# DEFAULT_WORKSPACE=/home/you/projects

# default | acceptEdits | plan | bypassPermissions | dontAsk | auto
# "default" asks before sensitive tools. A personal trusted machine may use
# bypassPermissions (the console emulates it with canUseTool, so it also works
# when the service runs as root).
DEFAULT_PERMISSION_MODE=default

# Global default appearance for the login page and new browsers.
# system | dark | light
DEFAULT_THEME=system

SESSION_IDLE_MINUTES=30
PERMISSION_TIMEOUT_MINUTES=30

LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_MINUTES=10
ACCOUNT_LOCK_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=60
SESSION_DAYS=7
COOKIE_SECURE=auto

TRUST_PROXY=true
# CLAUDE_BIN=/home/you/.local/bin/claude
LOG_LEVEL=info

# Optional egress proxy for voice provider HTTP calls (for example a local
# SOCKS/HTTP proxy). Leave empty to connect directly.
# VOICE_PROXY_URL=http://127.0.0.1:7890

# Gemini Live real-time dictation (optional). Live needs a WebSocket relay
# that can reach Google from a supported region. The URL should point at the
# relay's BidiGenerateContent path; the token is sent as x-proxy-token.
# GEMINI_LIVE_URL=wss://relay.example.com/ws/google.ai.generativelanguage.v1beta.GenerativeService.BidiGenerateContent
# GEMINI_LIVE_PROXY_TOKEN=
# GEMINI_LIVE_MODEL=gemini-3.5-transcribe-live
