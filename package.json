{
  "name": "claude-web",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted web console for Claude Code (sessions, streaming chat, tool approvals)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:server": "tsx watch server/src/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "vite build --config web/vite.config.ts",
    "build": "npm run build:server && npm run build:web",
    "start": "node dist/server/index.js",
    "set-password": "node scripts/set-password.mjs",
    "upstream": "node scripts/check-upstream.mjs",
    "check-secrets": "bash scripts/check-secrets.sh ."
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.330",
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^8.2.0",
    "@fastify/websocket": "^11.2.0",
    "bcryptjs": "^3.0.2",
    "fastify": "^5.6.0",
    "https-proxy-agent": "^9.1.0",
    "undici": "^8.13.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.10.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "ansi-to-html": "^0.7.2",
    "diff": "^8.0.2",
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3"
  }
}
